{
  "name": "homecoming-hackathon-2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ai:report": "tsx --env-file=.env scripts/ai-report.ts",
    "jobs:ingest": "tsx --env-file=.env scripts/ingest-jobs.ts",
    "jobs:boards": "tsx scripts/check-boards.ts",
    "check:reword": "tsx scripts/check-reword.mts",
    "postinstall": "prisma generate",
    "db:up": "docker compose -f docker-compose.local.yaml up -d",
    "db:down": "docker compose -f docker-compose.local.yaml down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "^1.7.7",
    "next": "16.3.8",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "mysql2": "^3.24.4"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true,
    "unrs-resolver": true
  }
}
