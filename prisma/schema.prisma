generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7 takes no `url` here: the migrate/seed URL lives in prisma.config.ts
// and the runtime connection is opened by the driver adapter in lib/db/client.ts.
datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// People
// ──────────────────────────────────────────────

model User {
  // Better Auth writes directly into this domain table: its default `user`
  // model resolves to prisma.user, and identity is matched by email. `name`,
  // `emailVerified` and `updatedAt` are its required columns.
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?
  // Marks the accounts the seed creates. The demo-login endpoint will only
  // issue a session for one of these, so it can't be aimed at a real sign-up.
  isDemo        Boolean @default(false)

  accounts Account[]
  sessions Session[]

  skills         UserSkill[]
  attempts       Attempt[]
  certifications Certification[]
  applications   Application[]
  experiences    Experience[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ──────────────────────────────────────────────
// Better Auth
// ──────────────────────────────────────────────
// Owned by Better Auth, not by app code — nothing outside lib/auth should read
// or write these. The password hash lives on Account.password (scrypt), which
// is why there is no password column on User.

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Purchasing keeps sessions in Redis (secondaryStorage) and so has no Session
// table. There's no Redis here, so they live in Postgres instead.
model Session {
  id        String   @id
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ──────────────────────────────────────────────
// Skills
// ──────────────────────────────────────────────

// The canonical skill vocabulary. Seeded from lib/profile/skills.ts so that
// "JS", "Javascript" and "ECMAScript" all collapse to one row — the quiz,
// job-listing and AI-prompt code all refer to skills by these slugs.
model Skill {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  // Nullable because the canonical vocabulary classifies by kind
  // ("language", "framework", "tool"), while careers group by field
  // ("Data", "Web Dev") — not every row has one.
  category    String?
  description String?

  quizzes        Quiz[]
  questions      Question[]
  users          UserSkill[]
  attempts       Attempt[]
  certifications Certification[]
  careerSkills   CareerSkill[]
  jobSkills      JobSkill[]
}

// Join row: this user has this skill, and here's where it came from. Passing a
// quiz upgrades an existing SELF_REPORTED row to QUIZ, which is what the
// recommender weights more heavily.
model UserSkill {
  id      String      @id @default(cuid())
  userId  String
  skillId String
  source  SkillSource @default(SELF_REPORTED)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, skillId])
}

enum SkillSource {
  SELF_REPORTED // typed in on the home screen
  RESUME // read off a resume the student pasted in — stronger than a claim, weaker than a pass
  QUIZ // proven by passing a quiz
}

// ──────────────────────────────────────────────
// Quizzes
// ──────────────────────────────────────────────

// Quizzes and their questions are CONTENT, authored as JSON in data/quizzes/
// and loaded into these tables by prisma/seed.ts. The seed replaces them
// wholesale on every run, which is why Attempt.quizId and Certification.quizId
// are plain strings rather than foreign keys — re-seeding content must never
// cascade into a user's earned history.

model Quiz {
  id               String @id // file stem in data/quizzes/, e.g. "sql"
  title            String
  description      String
  timeLimitSeconds Int? // optional countdown; not enforced server-side
  skillId          String
  skill            Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  questions Question[]

  @@index([skillId])
}

model Question {
  id      String @id // authored id from the JSON, e.g. "sql-1" — this is the
  //                    key the client's answer sheet is keyed by, so it has to
  //                    survive the round trip unchanged.
  quizId  String
  quiz    Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  order       Int // authored position within the quiz
  type        QuestionType
  prompt      String
  points      Int          @default(1)
  explanation String?
  difficulty  String? // "BEGINNER" | "INTERMEDIATE" | "ADVANCED"
  reviewed    Boolean      @default(false) // only reviewed ones count for certification

  // The answer key. Which columns are populated depends on `type`:
  //   MULTIPLE_CHOICE → options + correctOptionId
  //   MULTI_SELECT    → options + correctOptionIds
  //   TRUE_FALSE      → correctAnswer
  //   SHORT_ANSWER    → acceptedAnswers
  options          Json? // [{ id, text }] — the choices shown to the user
  correctOptionId  String?
  correctOptionIds String[]
  correctAnswer    Boolean?
  acceptedAnswers  String[]

  @@index([quizId, order])
  @@index([skillId, difficulty])
}

/// Mirrors the TS union in lib/quiz/levels.ts — the names must match exactly.
/// A compile-time check in prisma/queries.ts fails the build if they drift.
enum ProficiencyLevel {
  Beginner
  Intermediate
  Proficient
  Advanced
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTI_SELECT
  TRUE_FALSE
  SHORT_ANSWER
}

// ──────────────────────────────────────────────
// Attempts & certifications
// ──────────────────────────────────────────────

model Attempt {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  // Which authored quiz produced this attempt: the JSON file stem in
  // data/quizzes/. Null for an attempt generated from the Question bank.
  quizId  String?

  level     ProficiencyLevel // derived from score — see lib/quiz/levels.ts
  score     Int // percent
  answers   Json? // per-question record, handy for review/analytics
  createdAt DateTime @default(now())

  certification Certification?

  @@index([userId, skillId])
  @@index([userId, quizId])
}

// One certification per user per skill, holding their best result: a retake
// that scores higher upgrades the existing row rather than minting a second
// certificate, so a profile reads as one credential per skill. There is no
// pass/fail — every completed attempt earns a level.
model Certification {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  // The attempt that earned the current level. Optional so a certification can
  // outlive a pruned attempt; unique so an attempt can't back two of them.
  attemptId String?  @unique
  attempt   Attempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  quizId String? // authored quiz that earned it, when it came from one
  title  String // "JavaScript Fundamentals"
  level  ProficiencyLevel // the level printed on the certificate
  score  Int // percent on the attempt that earned it

  // Public URL at /certificates/[certId]. Separate from `id` so ids stay
  // unguessable even once a certificate is shared.
  shareSlug String @unique @default(cuid())

  earnedAt DateTime @default(now())

  @@unique([userId, skillId]) // upsert when they beat their previous score
  @@index([userId])
}

// ──────────────────────────────────────────────
// Careers
// ──────────────────────────────────────────────

model Career {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  field        String
  description  String?
  careerSkills CareerSkill[]
}

model CareerSkill {
  careerId String
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  weight   Int // 1-5 importance

  @@id([careerId, skillId])
}

// ──────────────────────────────────────────────
// Jobs
// ──────────────────────────────────────────────

// Also content: authored in data/jobs/listings.json and replaced wholesale by
// the seed. JobMatch.jobId coming back from the model is joined against these
// rows in code, not by a foreign key.
model Job {
  id          String  @id // "job-001"
  title       String
  company     String
  location    String
  remote      Boolean @default(false)
  level       String // "internship" | "entry" | "mid" | "senior"
  salaryRange String?
  description String
  url         String?

  skills       JobSkill[]
  applications Application[]
}

model JobSkill {
  jobId    String
  job      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  // Splits the extracted lists: required vs nice-to-have.
  required Boolean
  // 1-5 importance to this listing, same scale as CareerSkill.weight, assigned
  // by the ingest's extraction step. This is what makes matching a query: the
  // model's judgment about how central a skill is gets paid for once, here,
  // and every match afterwards is arithmetic over these numbers.
  //
  // Default 3 so rows ingested before weights existed still score sensibly;
  // re-running ingest on a listing replaces them with real ones.
  weight   Int     @default(3)

  @@id([jobId, skillId])
  @@index([skillId])
}

// ──────────────────────────────────────────────
// Applications
// ──────────────────────────────────────────────

// A student's own application tracker. Unlike Job (ingested content that the
// pipeline owns), this is USER HISTORY — the one thing in the jobs half of the
// schema that must never be lost to a re-ingest or a content reset.
//
// That's why the listing fields are copied in rather than read through `job`:
// an application to a listing that has since been pulled from the board should
// still say what it was. `jobId` is the link back to the live listing when
// there is one, which is also what makes it null for a manually added job.
model Application {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Null when the student typed this job in themselves. SetNull rather than
  // Cascade on purpose: deleting a listing must not delete the application.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  // Denormalized at save time — see the note above.
  title    String
  company  String
  location String?
  url      String?

  status    ApplicationStatus @default(SAVED)
  notes     String?
  // Set when status first reaches APPLIED, so the list can show "applied 3
  // days ago" without inferring it from updatedAt.
  appliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One application per listing per student. Postgres treats NULLs as
  // distinct, so this constrains the ingested-job case without limiting how
  // many jobs a student can add by hand.
  @@unique([userId, jobId])
  @@index([userId, status])
}

/// The pipeline a student moves an application along. SAVED is the "bookmarked
/// it, haven't applied" state, which is what the Save button on a job match
/// creates.
enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

// ──────────────────────────────────────────────
// Experience
// ──────────────────────────────────────────────

// What a student has actually done: jobs, projects, schooling, leadership.
// Two ways in, both landing here: typed in on /resume, or parsed out of a
// pasted resume by the same extraction call that finds skills.
//
// This is the structured half of the resume feature. Skills answer "what can
// you do" for matching; these answer "what have you done" for a human reader,
// and they're what a rendered resume is built from.
model Experience {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind         ExperienceKind @default(WORK)
  title        String // "Data Analyst Intern"
  organization String // "Wasatch Health Group"
  location     String?

  // Free text, NOT dates. Students write "Summer 2026" and "May 2026 - Aug
  // 2026"; a DateTime would demand precision they don't have and force the UI
  // to invent a day. A resume prints whatever they wrote, so store that.
  startDate String?
  endDate   String?
  current   Boolean @default(false)

  // One resume bullet per entry, in the order they should print.
  bullets String[]

  // Manual ordering within a kind. Newest-first is the resume convention, but
  // free-text dates can't be sorted, so the student's order is the order.
  sortOrder Int @default(0)

  // RESUME when parsed out of a pasted document, MANUAL when typed in. Lets a
  // re-paste replace what it previously parsed without touching hand-written
  // entries — the same rule UserSkill.source gives skills.
  source ExperienceSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum ExperienceKind {
  WORK
  PROJECT
  EDUCATION
  LEADERSHIP
}

enum ExperienceSource {
  MANUAL // typed in by the student
  RESUME // parsed out of a pasted resume
}
