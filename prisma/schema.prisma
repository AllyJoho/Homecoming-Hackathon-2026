generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7 takes no `url` here: the migrate/seed URL lives in prisma.config.ts
// and the runtime connection is opened by the driver adapter in lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  createdAt      DateTime        @default(now())
  attempts       Attempt[]
  certifications Certification[]
}

model Skill {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  category       String          // "Data", "Web Dev", "Communication"...
  description    String?
  questions      Question[]
  attempts       Attempt[]
  certifications Certification[]
  careerSkills   CareerSkill[]
}

model Question {
  id           String  @id @default(cuid())
  skillId      String
  skill        Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  prompt       String
  options      Json    // ["A", "B", "C", "D"]
  correctIndex Int
  difficulty   String  // "BEGINNER" | "INTERMEDIATE" | "ADVANCED"
  explanation  String?
  reviewed     Boolean @default(false) // only reviewed ones count for certification

  @@index([skillId, difficulty])
}

model Attempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level     String   // tier attempted
  score     Int      // percent
  passed    Boolean
  answers   Json?    // per-question record, handy for review/analytics
  createdAt DateTime @default(now())

  @@index([userId, skillId])
}

model Certification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level     String   // highest level passed
  earnedAt  DateTime @default(now())

  @@unique([userId, skillId]) // upsert when they pass a higher tier
}

model Career {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  field        String
  description  String?
  careerSkills CareerSkill[]
}

model CareerSkill {
  careerId String
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  weight   Int    // 1-5 importance

  @@id([careerId, skillId])
}
