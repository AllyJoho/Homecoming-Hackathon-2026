# Docker
COMPOSE_PROJECT_NAME=homecoming-hackathon-2026

# Postgres Database
# Written out flat rather than with ${VAR} interpolation: expansion only works
# in tools that opt into it (Next.js, docker-compose, prisma.config.ts), so a
# plain `node --env-file` run would otherwise get a literal "${POSTGRES_USER}".
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# Host port 5433, not 5432, so this doesn't collide with another local Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres?schema=public

# Anthropic API — powers the AI job matching in src/lib/jobs/recommend.ts.
# Without it the app still runs; /recommendations reports the missing key.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Authentication (Better Auth)
# Signs the session cookie. Generate one with: openssl rand -base64 32
# Required in production; lib/auth/server.ts falls back to an insecure dev
# value locally so a fresh clone can run `npm run dev` straight away.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
